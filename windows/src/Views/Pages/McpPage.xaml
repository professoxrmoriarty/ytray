<Page x:Class="YTray.Views.Pages.McpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="McpSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <Ellipse x:Name="Thumb" Width="17" Height="17" Margin="2" HorizontalAlignment="Left"
                                     Fill="{DynamicResource TextTertiaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrandOrangeBrush}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource BrandOrangeBrush}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrandOrangeBrush}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Fill" Value="White"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="McpTag" TargetType="Border">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <Style x:Key="McpCopyButton" TargetType="Button" BasedOn="{StaticResource YTrayGhostButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Page.Resources>

    <Grid Margin="26,14,26,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="506"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="MCP 服务" Style="{StaticResource PageTitle}" FontSize="26"/>
            <TextBlock Text="让 Agent 通过 YTray 安全地控制本机隔离浏览器。"
                       Style="{StaticResource PageSubtitle}" FontSize="12.5" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource SurfaceBorder}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="132"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <Grid Margin="20,16">
                    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource BrandPaleBrush}" VerticalAlignment="Top">
                            <Path Data="M 3 3 L 13 3 L 13 7 L 3 7 Z M 3 10 L 13 10 L 13 14 L 3 14 Z M 5 5 L 5.1 5 M 5 12 L 5.1 12"
                                  Width="22" Height="22" Stretch="Uniform" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.3" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,-1,20,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="YTray Browser MCP" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border x:Name="StatusPill" Margin="11,0,0,0" Padding="9,4" CornerRadius="10"
                                        Background="{DynamicResource SurfaceMutedBrush}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="HeaderStatusDot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="HeaderStatusText" FontSize="10.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock x:Name="ServiceStatusTitle" FontSize="11.5" FontWeight="SemiBold"/>
                                <TextBlock Text=" · " FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <TextBlock x:Name="ServiceStatusDetail" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="430"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="MCP 服务" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="立即启停" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <ToggleButton x:Name="ServiceToggle" Style="{StaticResource McpSwitch}"
                                              Checked="ServiceToggle_Changed" Unchecked="ServiceToggle_Changed"
                                              AutomationProperties.Name="启用或停止 MCP 服务"/>
                            </StackPanel>
                            <Border Width="1" Height="35" Margin="18,1" Background="{DynamicResource HairlineBrush}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="自动启动" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="随 YTray" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <ToggleButton x:Name="AutoStartToggle" Style="{StaticResource McpSwitch}"
                                              Checked="AutoStartToggle_Changed" Unchecked="AutoStartToggle_Changed"
                                              AutomationProperties.Name="随 YTray 自动启动 MCP"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="52,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="连接地址" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Height="36" Padding="11,0" CornerRadius="5" Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="EndpointText" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="CopyEndpointButton" Grid.Column="1" Content="复制地址" Click="CopyEndpoint_Click"
                                        Style="{StaticResource McpCopyButton}" Margin="8,0,0,0"
                                        AutomationProperties.Name="复制 MCP 地址"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Border Style="{StaticResource McpTag}"><TextBlock Text="Streamable HTTP" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                            <Border Style="{StaticResource McpTag}" Margin="0"><TextBlock Text="仅限 127.0.0.1" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource HairlineBrush}"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.03*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                    <Grid Margin="19,16,18,17">
                        <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="51"/><RowDefinition Height="31"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="连接配置" Style="{StaticResource SectionTitle}" FontSize="15"/>
                            <TextBlock Text="复制配置到客户端，重新连接后即可发现工具。" Margin="0,5,0,0"
                                       FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Columns="3" Margin="0,7,0,7">
                            <StackPanel Orientation="Horizontal"><Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource BrandPaleBrush}"><TextBlock Text="1" FontSize="10" Foreground="{DynamicResource BrandOrangeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="添加服务" Margin="7,2,0,0" FontSize="11"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource BrandPaleBrush}"><TextBlock Text="2" FontSize="10" Foreground="{DynamicResource BrandOrangeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="粘贴配置" Margin="7,2,0,0" FontSize="11"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource BrandPaleBrush}"><TextBlock Text="3" FontSize="10" Foreground="{DynamicResource BrandOrangeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="刷新连接" Margin="7,2,0,0" FontSize="11"/></StackPanel>
                        </UniformGrid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="VS Code · mcp.json" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button x:Name="CopyConfigButton" Grid.Column="1" Content="复制配置" Click="CopyConfig_Click"
                                    Style="{StaticResource McpCopyButton}"/>
                        </Grid>

                        <TextBox x:Name="ConfigTextBox" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" FontFamily="Consolas" FontSize="10.5"
                                 Padding="12,10" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"/>
                    </Grid>

                    <Border Grid.Column="1" Background="{DynamicResource HairlineBrush}"/>

                    <Grid Grid.Column="2" Margin="18,16,19,17">
                        <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="可用工具" Style="{StaticResource SectionTitle}" FontSize="15"/>
                                <TextBlock Text="Agent 连接后自动发现，无需单独安装插件。" Margin="0,5,0,0"
                                           FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Padding="9,4" CornerRadius="10" Background="{DynamicResource BrandPaleBrush}" VerticalAlignment="Top">
                                <TextBlock Text="5 个工具" FontSize="10" Foreground="{DynamicResource BrandOrangeBrush}"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="1"/><RowDefinition/><RowDefinition Height="1"/><RowDefinition/><RowDefinition Height="1"/><RowDefinition/><RowDefinition Height="1"/><RowDefinition/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="list_browser_runtimes" FontFamily="Consolas" FontSize="11.5"/><TextBlock Text="列出可用浏览器运行时" Margin="0,4,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><Border Grid.Column="1" Padding="7,2" CornerRadius="8" Background="{DynamicResource SurfaceMutedBrush}" VerticalAlignment="Center"><TextBlock Text="只读" HorizontalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></Border></Grid>
                            <Border Grid.Row="1" Background="{DynamicResource HairlineBrush}"/>
                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="list_browser_instances" FontFamily="Consolas" FontSize="11.5"/><TextBlock Text="列出运行中或历史浏览器实例" Margin="0,4,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><Border Grid.Column="1" Padding="7,2" CornerRadius="8" Background="{DynamicResource SurfaceMutedBrush}" VerticalAlignment="Center"><TextBlock Text="只读" HorizontalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></Border></Grid>
                            <Border Grid.Row="3" Background="{DynamicResource HairlineBrush}"/>
                            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="open_browser_instance" FontFamily="Consolas" FontSize="11.5"/><TextBlock Text="打开新的隔离浏览器实例" Margin="0,4,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><Border Grid.Column="1" Padding="7,2" CornerRadius="8" Background="{DynamicResource BrandPaleBrush}" VerticalAlignment="Center"><TextBlock Text="操作" HorizontalAlignment="Center" FontSize="10" Foreground="{DynamicResource BrandOrangeBrush}"/></Border></Grid>
                            <Border Grid.Row="5" Background="{DynamicResource HairlineBrush}"/>
                            <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="focus_browser_instance" FontFamily="Consolas" FontSize="11.5"/><TextBlock Text="聚焦指定的运行中实例" Margin="0,4,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><Border Grid.Column="1" Padding="7,2" CornerRadius="8" Background="{DynamicResource BrandPaleBrush}" VerticalAlignment="Center"><TextBlock Text="操作" HorizontalAlignment="Center" FontSize="10" Foreground="{DynamicResource BrandOrangeBrush}"/></Border></Grid>
                            <Border Grid.Row="7" Background="{DynamicResource HairlineBrush}"/>
                            <Grid Grid.Row="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="stop_browser_instance" FontFamily="Consolas" FontSize="11.5"/><TextBlock Text="停止实例并保留历史记录" Margin="0,4,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><Border Grid.Column="1" Padding="7,2" CornerRadius="8" Background="{DynamicResource BrandPaleBrush}" VerticalAlignment="Center"><TextBlock Text="操作" HorizontalAlignment="Center" FontSize="10" Foreground="{DynamicResource BrandOrangeBrush}"/></Border></Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
